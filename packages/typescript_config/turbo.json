{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // ESLint uses eslint-plugin-turbo, which reads workspace Turbo configs
    // and package manifests. Explicit root globs need a node_modules exclusion.
    "lint": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/**/turbo.json",
        "$TURBO_ROOT$/**/package.json",
        "!$TURBO_ROOT$/**/node_modules/**"
      ]
    }
  }
}
