{
  "name": "@rs/typescript-config",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "oxfmt -c ../oxlint-config/oxfmt.json --write .",
    "lint": "eslint --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/ .",
    "fix": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix ."
  },
  "dependencies": {
    "@tsconfig/strictest": "catalog:"
  },
  "devDependencies": {
    "@rs/eslint-config": "workspace:*",
    "eslint": "catalog:"
  }
}
