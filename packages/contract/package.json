{
  "name": "@ryangreenup/contract",
  "version": "0.0.0",
  "private": true,
  "description": "Shared data contracts",
  "license": "MIT",
  "author": "Ryan Greenup <ryanxgreenup@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsgo --skipLibCheck --noEmit",
    "lint": "oxlint --type-aware --type-check . && oxfmt -c node_modules/@ryangreenup/oxlint-config/oxfmt.json --check .",
    "format": "oxfmt -c node_modules/@ryangreenup/oxlint-config/oxfmt.json --write .",
    "fix": "oxlint --fix --fix-suggestions --type-aware --type-check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ryangreenup/oxlint-config": "workspace:*",
    "@ryangreenup/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
