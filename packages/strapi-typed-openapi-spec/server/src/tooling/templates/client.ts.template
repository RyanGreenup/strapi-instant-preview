import type {
  CallOptions,
  HTTPStatusCode2xx,
} from "./generated/runtime.js";

const BODY_PREVIEW_LENGTH = 200;
const DEFAULT_TIMEOUT_MS = 10_000;

////////////////////////////////////////////////////////////
// Result //////////////////////////////////////////////////
////////////////////////////////////////////////////////////

/** Result enum, like Rust. */
type Result<T, E> =
  | { readonly ok: true; readonly value: T }
  | { readonly ok: false; readonly error: E };

/** Success variant containing the value. */
const ok = <T>(value: T): Result<T, never> => ({ ok: true, value });

/** Error variant containing the error. */
const err = <E>(error: E): Result<never, E> => ({ ok: false, error });

////////////////////////////////////////////////////////////
// Errors //////////////////////////////////////////////////
////////////////////////////////////////////////////////////

interface RequestContext {
  readonly url: string;
  readonly method: string;
}

/**
 * Base class of every error a bound operation can return.
 *
 * Each is a real `Error` with a stack trace from the failure site, the
 * original exception as `cause`, and a `toJSON()` for structured logging.
 */
abstract class CmsErrorBase extends Error {
  /** Discriminant: `switch (error.kind)` narrows to the concrete class. */
  public abstract readonly kind: string;
  public readonly url: string;
  public readonly method: string;

  protected constructor(
    summary: string,
    context: RequestContext,
    cause?: unknown,
  ) {
    super(
      `${summary} (${context.method} ${context.url})`,
      cause === undefined ? undefined : { cause },
    );
    this.name = new.target.name;
    this.url = context.url;
    this.method = context.method;
  }

  /** Plain-object form for logging. `JSON.stringify(error)` uses it. */
  public toJSON(): Record<string, unknown> {
    return {
      name: this.name,
      kind: this.kind,
      message: this.message,
      url: this.url,
      method: this.method,
      stack: this.stack,
      cause: describeCause(this.cause),
    };
  }
}

/** The request could not be built, e.g. a bad path or an unencodable body. */
class InvalidRequestError extends CmsErrorBase {
  public readonly kind = "invalid-request";
  public constructor(context: RequestContext, cause: unknown) {
    super(`Could not build request: ${messageOf(cause)}`, context, cause);
  }
}

/** No response arrived, e.g. DNS failure, refused connection, CORS. */
class NetworkError extends CmsErrorBase {
  public readonly kind = "network";
  public constructor(context: RequestContext, cause: unknown) {
    super(`Network error: ${messageOf(cause)}`, context, cause);
  }
}

/** The timeout elapsed before the response (headers or body) finished. */
class FetchTimeoutError extends CmsErrorBase {
  public readonly kind = "timeout";
  public constructor(context: RequestContext, cause: unknown) {
    super("Request timed out", context, cause);
  }
}

/** The caller's `signal` aborted the request. */
class FetchAbortedError extends CmsErrorBase {
  public readonly kind = "aborted";
  public constructor(context: RequestContext, cause: unknown) {
    super("Request was aborted", context, cause);
  }
}

/**
 * The server responded with a non-2xx status. `data` is the parsed body,
 * typed by the contract for that status: check `status` to narrow it.
 */
class HttpError<
  Status extends number = number,
  Data = unknown,
> extends CmsErrorBase {
  public readonly kind = "http";
  public readonly status: Status;
  public readonly statusText: string;
  public readonly data: Data;
  public readonly headers: Headers;

  public constructor(
    context: RequestContext,
    response: { status: Status; data: Data; headers: Headers },
    statusText: string,
  ) {
    const preview = bodyPreview(response.data);
    super(
      `HTTP ${response.status} ${statusText}${preview ? `: ${preview}` : ""}`,
      context,
    );
    this.status = response.status;
    this.statusText = statusText;
    this.data = response.data;
    this.headers = response.headers;
  }

  public override toJSON(): Record<string, unknown> {
    return {
      ...super.toJSON(),
      status: this.status,
      bodyPreview: bodyPreview(this.data),
    };
  }
}

/** The response said it was JSON, but its body did not parse. */
class JsonParseError extends CmsErrorBase {
  public readonly kind = "json-parse";
  public readonly status: number | undefined;

  public constructor(
    context: RequestContext,
    status: number | undefined,
    cause: unknown,
  ) {
    super(`Response was not valid JSON: ${messageOf(cause)}`, context, cause);
    this.status = status;
  }

  public override toJSON(): Record<string, unknown> {
    return { ...super.toJSON(), status: this.status };
  }
}

/**
 * One problem found by response validation: the JSON Schema keyword that
 * failed (`code`) and where in the body (`path`).
 */
interface ValidationIssue {
  readonly code?: string;
  readonly message: string;
  readonly path: readonly PropertyKey[];
}

/** A 2xx body that did not match the contract's schema. */
class ValidationError extends CmsErrorBase {
  public readonly kind = "validation";
  public readonly status: number;
  public readonly issues: readonly ValidationIssue[];
  /** The payload that failed validation, for inspecting in a debugger. */
  public readonly received: unknown;

  public constructor(
    context: RequestContext,
    status: number,
    error: { message: string; issues: readonly ValidationIssue[] },
    received: unknown,
  ) {
    super(`Response failed validation: ${error.message}`, context);
    this.status = status;
    this.issues = error.issues;
    this.received = received;
  }

  public override toJSON(): Record<string, unknown> {
    return { ...super.toJSON(), status: this.status, issues: this.issues };
  }
}

/** Something outside the cases above threw. */
class UnexpectedError extends CmsErrorBase {
  public readonly kind = "unexpected";
  public constructor(context: RequestContext, cause: unknown) {
    super(`Unexpected failure: ${messageOf(cause)}`, context, cause);
  }
}

function messageOf(value: unknown): string {
  return value instanceof Error ? value.message : String(value);
}

function describeCause(cause: unknown): unknown {
  if (cause === undefined) return undefined;
  if (cause instanceof Error) {
    return { name: cause.name, message: cause.message, stack: cause.stack };
  }
  return String(cause);
}

function bodyPreview(data: unknown): string {
  if (data === undefined || data === null) return "";
  const text = typeof data === "string" ? data : JSON.stringify(data);
  return (text ?? "").slice(0, BODY_PREVIEW_LENGTH);
}

/** Classify a rejection from `fetch()` or from reading the body. */
function transportError(
  context: RequestContext,
  signal: AbortSignal | null | undefined,
  cause: unknown,
): NetworkError | FetchTimeoutError | FetchAbortedError {
  const name = cause instanceof Error ? cause.name : undefined;
  if (name === "TimeoutError") return new FetchTimeoutError(context, cause);
  if (name === "AbortError" || signal?.aborted) {
    return new FetchAbortedError(context, cause);
  }
  return new NetworkError(context, cause);
}

////////////////////////////////////////////////////////////
// Client //////////////////////////////////////////////////
////////////////////////////////////////////////////////////

/**
 * Any CMS operation, such as `getArticles`. The helper types below take one
 * as `typeof getArticles`.
 */
type CmsOperation = (
  ...args: never[]
) => Promise<{ status: number; data: unknown; headers: Headers }>;

/** The response union of one operation, over every documented status. */
type CmsResponse<Op extends CmsOperation> = Awaited<ReturnType<Op>>;

/** The 2xx responses of one operation: the `value` of a successful call. */
type CmsSuccess<Op extends CmsOperation> = Extract<
  CmsResponse<Op>,
  { status: HTTPStatusCode2xx }
>;

/** One `HttpError` per documented error status, so `status` narrows `data`. */
type CmsHttpError<Op extends CmsOperation> =
  Exclude<CmsResponse<Op>, { status: HTTPStatusCode2xx }> extends infer R
    ? R extends { status: infer S extends number; data: infer D }
      ? HttpError<S, D>
      : never
    : never;

/**
 * Every error a bound operation can return. Narrow it with `error.kind`,
 * then with `error.status` for `"http"`.
 */
type CmsError<Op extends CmsOperation> =
  | CmsHttpError<Op>
  | InvalidRequestError
  | NetworkError
  | FetchTimeoutError
  | FetchAbortedError
  | JsonParseError
  | ValidationError
  | UnexpectedError;

/**
 * The body of one CMS operation's response for a given status, for example
 * `CmsData<typeof getArticles>` or `CmsData<typeof getArticles, 401>`.
 */
type CmsData<
  Op extends CmsOperation,
  Status extends CmsResponse<Op>["status"] = 200,
> = Extract<CmsResponse<Op>, { status: Status }>["data"];

/** A relation that Strapi sent as `{ count }` instead of its entries. */
interface RelationCount {
  count: number;
}

/** True only for exactly `{ count: number }`, not for an entry with a count field. */
type IsRelationCount<Value> = Value extends RelationCount
  ? Exclude<keyof Value, "count"> extends never
    ? true
    : false
  : false;

/**
 * A response body with relation counts removed from every relation's type.
 * Strapi sends `{ count }` only when a query asks for it, so a caller that
 * never does can bind with `{ populated: true }` and get this type.
 *
 * Only a union member that is exactly `{ count: number }` is removed, so an
 * entry with its own `count` field keeps it.
 */
type Populated<Value> = Value extends unknown
  ? IsRelationCount<Value> extends true
    ? never
    : Value extends object
      ? { [Key in keyof Value]: Populated<Value[Key]> }
      : Value
  : never;

/** A 2xx response whose `data` is {@link Populated}. */
type PopulatedSuccess<Response> = Response extends { data: infer Data }
  ? Omit<Response, "data"> & { data: Populated<Data> }
  : Response;

////////////////////////////////////////////////////////////
// Populate-aware responses
////////////////////////////////////////////////////////////

/** Marks a call without a `populate` argument: its response stays as generated. */
interface NoTree {
  readonly "cms-client.no-tree": true;
}

/** A key the tree does not populate: Strapi leaves it out. */
interface Absent {
  readonly "cms-client.absent": true;
}

/** A key whose population the tree's type cannot tell: it stays as generated. */
interface Unknown {
  readonly "cms-client.unknown": true;
}

/** The populate values that turn a key off, and those that turn it on. */
type Off = false | "false" | "f" | "0" | null | undefined;
type On = true | "true" | "t" | "1";

/** `"a,b"` as `"a" | "b"`. */
type Split<Names extends string> =
  Names extends `${infer Head},${infer Tail}` ? Head | Split<Tail> : Names;

/** What a list of names (`"a,b.c"`, `["a", "b.c"]`) populates at `Key`. */
type Named<Name extends string, Key extends string> = string extends Name
  ? Unknown
  : "*" extends Name
    ? true
    : [Name extends `${Key}.${infer Tail}` ? Tail : never] extends [never]
      ? Key extends Name
        ? true
        : Absent
      : { readonly populate: Name extends `${Key}.${infer Tail}` ? Tail : never };

/** What one tree populates at `Key`: a branch, {@link Absent} or {@link Unknown}. */
type AtOne<Tree, Key extends string> = Tree extends Off
  ? Absent
  : Tree extends On
    ? true
    : Tree extends string
      ? Named<Split<Tree>, Key>
      : Tree extends readonly (infer Name)[]
        ? Name extends string
          ? Named<Split<Name>, Key>
          : Unknown
        : Tree extends { readonly populate: infer Inner }
          ? At<Inner, Key>
          : Tree extends object
            ? {} extends Tree
              ? Unknown
              : Key extends keyof Tree
                ? Branch<Tree[Key]>
                : Absent
            : Unknown;

/** A value under one key of a populate object. */
type Branch<Value> = Value extends Off ? Absent : Value extends On ? true : Value;

/**
 * What `Tree` populates at `Key`. A tree type that allows both (a variable
 * typed `boolean`, the generated parameter type) is {@link Unknown}.
 */
type At<Tree, Key extends string> = [Tree] extends [never]
  ? Absent
  : Decide<Tree extends unknown ? AtOne<Tree, Key> : never>;
type Decide<Found> = [Extract<Found, Unknown>] extends [never]
  ? [Extract<Found, Absent>] extends [never]
    ? Found
    : [Exclude<Found, Absent>] extends [never]
      ? Absent
      : Unknown
  : Unknown;

/** The tree below a populated key; a wide options type is unknown. */
type Below<Found> = Found extends { readonly populate: infer Inner }
  ? Inner
  : Found extends object
    ? {} extends Found
      ? string
      : never
    : never;

type Item<Value> = Value extends readonly (infer Element)[] ? Element : Value;

/**
 * Whether a key holds a relation, media or component. Their values (or
 * array elements) are entries with an `id`; scalars, blocks and json never
 * are.
 */
type IsEntry<Value> = [
  Extract<Item<NonNullable<Value>>, { id: number }>,
] extends [never]
  ? false
  : true;

type WithoutCount<Value> = Value extends unknown
  ? IsRelationCount<Value> extends true
    ? never
    : Value
  : never;
type OnlyCount<Value> = Value extends unknown
  ? IsRelationCount<Value> extends true
    ? Value
    : never
  : never;

/** A dynamic zone entry takes the fragment its `__component` names in `on`. */
type Shape<Value, Found> = Value extends { readonly __component: infer Name }
  ? Found extends { readonly on: infer Fragments }
    ? Name extends keyof Fragments
      ? Selected<Value, Below<Branch<Fragments[Name]>>>
      : Selected<Value, never>
    : Selected<Value, Below<Found>>
  : Selected<Value, Below<Found>>;

/**
 * A populated key's value. `{ count: true }` gives the count where the
 * contract allows one; elsewhere Strapi ignores it and sends the entries.
 */
type Apply<Value, Found> = Found extends { readonly count: true | "true" }
  ? [OnlyCount<Value>] extends [never]
    ? Entries<Value, Found>
    : OnlyCount<Value>
  : Entries<Value, Found>;
type Entries<Value, Found> =
  WithoutCount<Value> extends infer Kept
    ? Kept extends readonly (infer Element)[]
      ? Shape<Element, Found>[]
      : Kept extends null
        ? null
        : Shape<Kept, Found>
    : never;

type KeyState<Value, Tree, Key> = IsEntry<Value> extends false
  ? "keep"
  : At<Tree, Key & string> extends infer Found
    ? [Found] extends [Absent]
      ? "drop"
      : [Found] extends [Unknown]
        ? "keep"
        : "populated"
    : never;

type Flat<Value> = { [Key in keyof Value]: Value[Key] } & {};

/**
 * A document as Strapi sends it for populate tree `Tree`.
 *
 * A relation, media or component key is required when `Tree` populates it
 * and absent when it does not. Strapi leaves unpopulated ones out. A key the
 * tree's type cannot tell about, such as one populated through a variable,
 * keeps its generated type. Scalars always do.
 */
type Selected<Document, Tree> = Document extends object
  ? Document extends readonly unknown[]
    ? Document
    : Flat<
        {
          [Key in keyof Document as KeyState<
            Document[Key],
            Tree,
            Key
          > extends "keep"
            ? Key
            : never]: Document[Key];
        } & {
          [Key in keyof Document as KeyState<
            Document[Key],
            Tree,
            Key
          > extends "populated"
            ? Key
            : never]-?: Apply<
            Exclude<Document[Key], undefined>,
            At<Tree, Key & string>
          >;
        }
      >
  : Document;

/** A response body (`{ data, meta }`) whose documents are {@link Selected}. */
type SelectedBody<Body, Tree> = Body extends { data: infer Data }
  ? Omit<Body, "data"> & {
      data: Data extends readonly (infer Document)[]
        ? Selected<Document, Tree>[]
        : Selected<Data, Tree>;
    }
  : Body;

/** A 2xx response whose body's documents are {@link Selected}. */
type SelectedSuccess<Response, Tree> = Response extends { data: infer Body }
  ? Omit<Response, "data"> & { data: SelectedBody<Body, Tree> }
  : Response;

/** A populate tree as a `const` type parameter infers it: readonly throughout. */
type ReadonlyTree<Tree> = Tree extends readonly (infer Element)[]
  ? readonly ReadonlyTree<Element>[]
  : Tree extends object
    ? { readonly [Key in keyof Tree]: ReadonlyTree<Tree[Key]> }
    : Tree;

type HasPopulate<Value> = [NonNullable<Value>] extends [{ populate?: unknown }]
  ? true
  : false;

/** The populate trees an operation's arguments accept. */
type TreeFor<Args extends readonly unknown[]> = {
  [Index in keyof Args]: NonNullable<Args[Index]> extends {
    populate?: infer Tree;
  }
    ? ReadonlyTree<NonNullable<Tree>>
    : never;
}[number];

/** The arguments with `populate` typed as `Tree`. */
type WithTree<Args extends readonly unknown[], Tree> = {
  [Index in keyof Args]: HasPopulate<Args[Index]> extends true
    ?
        | (Omit<NonNullable<Args[Index]>, "populate"> & {
            readonly populate?: Tree;
          })
        | Extract<Args[Index], undefined>
    : Args[Index];
};

/** The response of a call with populate tree `Tree`. */
type TreeSuccess<Response, Tree, IsPopulated extends boolean> = [
  Tree,
] extends [NoTree]
  ? IsPopulated extends true
    ? PopulatedSuccess<Response>
    : Response
  : IsPopulated extends true
    ? PopulatedSuccess<SelectedSuccess<Response, Tree>>
    : SelectedSuccess<Response, Tree>;

/**
 * One bound operation. A literal `populate` argument types the response:
 * the relations, media and components it names are present, the others
 * absent. Without one, the response is typed as generated.
 */
type BoundOperation<Op extends CmsOperation, IsPopulated extends boolean> = <
  const Tree extends TreeFor<Parameters<Op>> | NoTree = NoTree,
>(
  ...args: WithTree<Parameters<Op>, Tree>
) => Promise<
  Result<TreeSuccess<CmsSuccess<Op>, Tree, IsPopulated>, CmsError<Op>>
>;

/**
 * Checks a body for one status. `undefined` means no schema to check. With
 * `populated`, a relation count fails the check.
 */
type Validator = (
  status: number,
  data: unknown,
  populated: boolean,
) =>
  | { success: true; data: unknown }
  | {
      success: false;
      error: { message: string; issues: readonly ValidationIssue[] };
    }
  | undefined;

/** Where validated operations keep their {@link Validator}. */
const validatorKey = Symbol.for("cms-client.validator");

/** What the generator knows about one operation, for {@link bindClient}. */
interface OperationInfo {
  /** The HTTP method, in upper case. */
  readonly method: string;
  /** The contract's path template, such as `/articles/{id}`. */
  readonly path: string;
  /** The position of the trailing `CallOptions` parameter. */
  readonly optionsIndex: number;
}

/** Where generated operations keep their {@link OperationInfo}. */
const operationKey = Symbol.for("cms-client.operation");

/**
 * Copy an operation with extra properties.
 *
 * Extra properties may include e.g. its {@link OperationInfo} or {@link
 * Validator}. Properties already on the operation are kept and the original
 * operation is not changed.
 */
const annotate = <Op extends CmsOperation>(
  operation: Op,
  properties: Readonly<Record<symbol, unknown>>,
): Op => {
  const copy = (...args: never[]): ReturnType<Op> =>
    // oxlint-disable-next-line typescript/no-unsafe-type-assertion
    Reflect.apply(operation, undefined, args) as ReturnType<Op>;
  // oxlint-disable-next-line typescript/no-unsafe-type-assertion
  return Object.assign(copy, operation, properties) as unknown as Op;
};

/** Give an operation its generated {@link OperationInfo}. */
const describeOperation = <Op extends CmsOperation>(
  operation: Op,
  info: OperationInfo,
): Op => annotate(operation, { [operationKey]: info });

/** An empty path segment, or one that resolves to `.` or `..`. */
const isUnsafeSegment = (segment: string): boolean =>
  segment === "" || /^(?:\.|%2e){1,2}$/iu.test(segment);

/**
 * A configured CMS connection. Pass it to {@link bindClient}, or as the
 * last argument of a raw operation.
 *
 * Spread it to add per-call options, such as `{ ...client, signal }`. A
 * `fetch` set that way replaces the client's own for that call: it then gets
 * the bare operation path, with no base URL, token or timeout.
 */
type CmsClient = CallOptions & { fetch: typeof globalThis.fetch };

/** Each client fetch's base URL, so errors can name the full URL. */
const baseUrls = new WeakMap<typeof globalThis.fetch, string>();

/** The page's URL in a browser; `undefined` elsewhere. */
const pageUrl = (): string | undefined =>
  // Typed here, so projects without the DOM types still compile.
  // oxlint-disable-next-line typescript/no-unsafe-type-assertion
  (globalThis as { location?: { href?: string } }).location?.href;

/**
 * Create a CMS client for one server and, optionally, one token. Each client
 * keeps its own settings, so several can run side by side.
 *
 * @param options - Where to send requests, and how to authenticate them.
 * @returns The client, to pass to {@link bindClient}.
 */
const createCmsClient = (options: {
  /**
   * The API root, including any path prefix, for example
   * `https://cms.example.com/api`. Operation paths are appended to it.
   */
  baseUrl: string | URL;
  /** A bearer token. It is sent unless a call sets its own `Authorization`. */
  token?: string;
  /**
   * Abort each request after this many milliseconds (default 10s). A
   * caller's `signal` still applies as well.
   *
   * The timeout also applies to writes. If the server finishes a write
   * after it, the call reports `timeout` for a write that succeeded, and
   * a user may send it again. Give a client for slow writes (such as a
   * form that sends an email before answering) a longer timeout.
   */
  timeoutMs?: number;
  /**
   * The `fetch` to send requests with. Defaults to the global `fetch`,
   * looked up for each request, so a polyfill or test stub installed after
   * the client was created is still used.
   */
  fetch?: typeof globalThis.fetch;
}): CmsClient => {
  let baseUrl = String(options.baseUrl);
  while (baseUrl.endsWith("/")) {
    baseUrl = baseUrl.slice(0, -1);
  }
  const send: typeof globalThis.fetch =
    options.fetch ?? (async (input, init) => await globalThis.fetch(input, init));
  const timeoutMs = options.timeoutMs ?? DEFAULT_TIMEOUT_MS;

  // Async, so a bad path rejects like any other failed fetch.
  const fetch: typeof globalThis.fetch = async (input, init) => {
    const method = (init?.method ?? "GET").toUpperCase();
    if (typeof input !== "string" || !input.startsWith("/")) {
      throw new InvalidRequestError(
        { url: String(input), method },
        new TypeError("Expected a CMS operation path starting with /"),
      );
    }
    // An empty ID would reach a different route (`/articles/` is the list),
    // and `.` or `..` would climb out of the API root once the URL is parsed.
    const [path = ""] = input.split(/[?#]/u, 1);
    if (path.split("/").slice(1).some(isUnsafeSegment)) {
      throw new InvalidRequestError(
        { url: `${baseUrl}${input}`, method },
        new TypeError("A path parameter is empty, `.` or `..`"),
      );
    }
    const url = `${baseUrl}${input}`;
    // A bad base URL or header value (such as a token with a line break) is
    // the caller's mistake, not the network's: report it before sending.
    let headers: Headers;
    try {
      // In a browser, a relative base URL resolves against the page.
      if (!URL.canParse(url, pageUrl())) {
        throw new TypeError(`Invalid URL: ${url}`);
      }
      headers = new Headers(init?.headers);
      if (!headers.has("accept")) {
        headers.set("accept", "application/json");
      }
      if (options.token !== undefined && !headers.has("authorization")) {
        headers.set("authorization", `Bearer ${options.token}`);
      }
    } catch (cause) {
      throw new InvalidRequestError({ url, method }, cause);
    }
    const timeout = AbortSignal.timeout(timeoutMs);
    const signal = init?.signal
      ? AbortSignal.any([init.signal, timeout])
      : timeout;
    return await send(url, { ...init, headers, signal });
  };
  baseUrls.set(fetch, baseUrl);

  return { fetch };
};

/**
 * Operations bound by {@link bindClient}: same parameters, but each call
 * resolves to a `Result` and never throws or rejects, and a literal
 * `populate` argument types the response (see {@link BoundOperation}).
 */
type BoundOperations<
  Operations extends Record<string, CmsOperation>,
  IsPopulated extends boolean = false,
> = {
  [K in keyof Operations]: BoundOperation<Operations[K], IsPopulated>;
};

/** Options for {@link bindClient}. */
interface BindOptions<IsPopulated extends boolean = false> {
  /**
   * Treat a relation sent as `{ count }` as invalid, and type every
   * relation without it (see {@link Populated}). Use this when no query
   * asks for counts (`populate[key][count]=true`).
   */
  populated?: IsPopulated;
}

/**
 * Bind operations to a client, so they can be called as methods:
 *
 * ```ts
 * import { bindClient, createCmsClient, getArticles } from "./cms-client/index.js";
 *
 * const cms = bindClient(createCmsClient({ baseUrl }), { getArticles });
 * const result = await cms.getArticles({ pagination: { page: 1 } });
 * if (!result.ok) {
 *   switch (result.error.kind) {
 *     case "http":
 *       if (result.error.status === 401) return login(); // error.data: StrapiError401
 *       break;
 *     case "validation":
 *       console.error(result.error.issues);
 *       break;
 *   }
 *   throw result.error; // message, stack and cause chain
 * }
 * result.value.data; // the 2xx body
 * ```
 *
 * Operations imported from `index.js` check 2xx bodies against the
 * contract with TypeBox. Import them from `unchecked.js` instead to skip that:
 * TypeBox is then left out of the bundle.
 *
 * Pass only the operations you use: bundlers keep exactly those. Options
 * given in a call are merged over the client's, except those set to
 * `undefined`: `{ fetch: undefined }` keeps the client's fetch, and with it
 * the base URL and token.
 *
 * @param client - The client from {@link createCmsClient}.
 * @param operations - The operations to bind, keyed by the method names to
 *   give them.
 * @param options - See {@link BindOptions}.
 * @returns The bound operations.
 */
const bindClient = <
  Operations extends Record<string, CmsOperation>,
  IsPopulated extends boolean = false,
>(
  client: CmsClient,
  operations: Operations,
  options: BindOptions<IsPopulated> = {},
): BoundOperations<Operations, IsPopulated> =>
  // oxlint-disable-next-line typescript/no-unsafe-type-assertion
  Object.fromEntries(
    Object.entries(operations).map(([name, operation]) => [
      name,
      (...args: unknown[]) =>
        call(client, operation, args, options.populated === true),
    ]),
  ) as unknown as BoundOperations<Operations, IsPopulated>;

/** The defined values of a per-call options argument. */
function definedOptions(given: unknown): Partial<CallOptions> {
  if (typeof given !== "object" || given === null) return {};
  return Object.fromEntries(
    Object.entries(given).filter(([, value]) => value !== undefined),
  );
}

async function call(
  client: CmsClient,
  operation: CmsOperation,
  args: unknown[],
  populated: boolean,
): Promise<Result<unknown, unknown>> {
  // oxlint-disable-next-line typescript/no-unsafe-type-assertion
  const info = (operation as { [operationKey]?: OperationInfo })[operationKey];
  // Without generated info (a hand-written operation), assume the options
  // come last. `length` stops counting at a default or rest parameter.
  const slot = info?.optionsIndex ?? Math.max(operation.length - 1, 0);
  const options: CallOptions = { ...client, ...definedOptions(args[slot]) };

  // Record what was sent, so every error can name the request. Until the
  // operation builds its URL, name its path template.
  const send = options.fetch ?? globalThis.fetch;
  let context: RequestContext = {
    url: info === undefined ? "" : `${baseUrls.get(send) ?? ""}${info.path}`,
    method: info?.method ?? "GET",
  };
  let sent = false;
  let responded = false;
  let signal: AbortSignal | null | undefined;
  let statusText = "";
  let status: number | undefined;
  options.fetch = async (input, init) => {
    const url = input instanceof Request ? input.url : String(input);
    context = {
      url: url.startsWith("/") ? `${baseUrls.get(send) ?? ""}${url}` : url,
      method: (init?.method ?? "GET").toUpperCase(),
    };
    signal = init?.signal;
    sent = true;
    let response: Response;
    try {
      response = await send(input, init);
    } catch (cause) {
      // Classify here, where it is certain: only a failed send is a
      // transport error.
      if (cause instanceof CmsErrorBase) throw cause;
      throw transportError(context, signal, cause);
    }
    responded = true;
    context = { ...context, url: response.url || context.url };
    statusText = response.statusText;
    status = response.status;
    return response;
  };

  const callArgs = Array.from({ length: slot }, (_, index) => args[index]);
  callArgs.push(options);

  let response: Awaited<ReturnType<CmsOperation>>;
  try {
    response = await Reflect.apply(operation, undefined, callArgs);
  } catch (cause) {
    if (cause instanceof CmsErrorBase) return err(cause);
    // Orval builds the URL and body before calling fetch.
    if (!sent) return err(new InvalidRequestError(context, cause));
    // After the response arrived, the body is read and parsed. A
    // SyntaxError there is the JSON; anything else broke the body stream.
    if (responded) {
      if (cause instanceof SyntaxError) {
        return err(new JsonParseError(context, status, cause));
      }
      return err(transportError(context, signal, cause));
    }
    return err(new UnexpectedError(context, cause));
  }

  if (response.status < 200 || response.status > 299) {
    return err(new HttpError(context, response, statusText));
  }

  // oxlint-disable-next-line typescript/no-unsafe-type-assertion
  const validate = (operation as { [validatorKey]?: Validator })[validatorKey];
  if (validate === undefined) return ok(response);
  try {
    const checked = validate(response.status, response.data, populated);
    if (checked === undefined) return ok(response);
    return checked.success
      ? ok({ ...response, data: checked.data })
      : err(
          new ValidationError(
            context,
            response.status,
            checked.error,
            response.data,
          ),
        );
  } catch (cause) {
    return err(new UnexpectedError(context, cause));
  }
}

