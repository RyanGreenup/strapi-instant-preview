/**
 * The CMS client. Operations from here check 2xx bodies against the
 * contract with TypeBox when called through `bindClient`:
 *
 * ```ts
 * import { bindClient, createCmsClient, getArticles } from "./cms-client/index.js";
 *
 * const cms = bindClient(createCmsClient({ baseUrl, token }), { getArticles });
 * const result = await cms.getArticles({ pagination: { page: 1 } });
 * ```
 *
 * To skip validation and leave TypeBox out of the bundle, import the same names
 * from `./cms-client/unchecked.js` instead.
 */
// Each operation is its own export, so bundlers keep only the ones used.
// oxlint-disable-next-line oxc/no-barrel-file
export * from "./client.js";
export * from "./generated/checked.js";
