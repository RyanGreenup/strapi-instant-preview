import { Compile, type Validator as Compiled, type XSchema } from "typebox/schema";

import {
  annotate,
  type CmsOperation,
  type ValidationIssue,
  type Validator,
  validatorKey,
} from "./client.js";
import { $defs } from "./generated/schemas.js";

/** `/data/0/id` to `["data", 0, "id"]`. */
function pathOf(pointer: string): PropertyKey[] {
  return pointer
    .split("/")
    .slice(1)
    .map((part) => part.replaceAll("~1", "/").replaceAll("~0", "~"))
    .map((part) => (/^\d+$/u.test(part) ? Number(part) : part));
}

/**
 * The component schemas, and the same with no relation counts allowed.
 * Every relation refers to `StrapiCount` by name, so replacing it with
 * `false` (matches nothing) rejects a count wherever one could appear.
 */
// oxlint-disable-next-line typescript/no-unsafe-type-assertion
const definitions = $defs as Record<string, XSchema>;
const populatedDefinitions: Record<string, XSchema> = {
  ...definitions,
  StrapiCount: false,
};

const registered: Record<string, XSchema> = {};
let operationCount = 0;
const compiled = new Map<
  boolean,
  { readonly validator: Compiled; readonly size: number }
>();

const validatorFor = (populated: boolean): Compiled => {
  const size = Object.keys(registered).length;
  const cached = compiled.get(populated);
  if (cached !== undefined && cached.size === size) return cached.validator;
  const validator = Compile(
    populated ? populatedDefinitions : definitions,
    { type: "object", properties: { ...registered } },
  );
  compiled.set(populated, { validator, size });
  return validator;
};

/**
 * Give an operation the contract's JSON Schemas for its 2xx bodies, keyed by
 * status. Returns a copy: the operation itself stays unchecked.
 */
export const withSchemas = <Op extends CmsOperation>(
  operation: Op,
  schemas: Readonly<Record<number, object>>,
): Op => {
  const id = operationCount++;
  for (const [status, schema] of Object.entries(schemas)) {
    // oxlint-disable-next-line typescript/no-unsafe-type-assertion
    registered[`${id}:${status}`] = schema as XSchema;
  }
  const validate: Validator = (status, data, populated) => {
    if (schemas[status] === undefined) return undefined;
    // The wrapper's property is optional, so an undefined body would pass.
    if (data === undefined) {
      const message = "/ must not be undefined";
      return {
        success: false,
        error: { message, issues: [{ code: "type", message, path: [] }] },
      };
    }
    const key = `${id}:${status}`;
    const validator = validatorFor(populated);
    const wrapped = { [key]: data };
    if (validator.Check(wrapped)) return { success: true, data };
    const [, wrappedErrors] = validator.Errors(wrapped);
    const prefix = `/${key}`;
    const errors = wrappedErrors.map((error) => ({
      ...error,
      instancePath: error.instancePath.slice(prefix.length),
    }));
    const issues: ValidationIssue[] = errors.map((error) => ({
      code: error.keyword,
      message: error.message,
      path: pathOf(error.instancePath),
    }));
    const message = errors
      .map((error) => `${error.instancePath || "/"} ${error.message}`)
      .join("; ");
    return { success: false, error: { message, issues } };
  };
  return annotate(operation, { [validatorKey]: validate });
};
