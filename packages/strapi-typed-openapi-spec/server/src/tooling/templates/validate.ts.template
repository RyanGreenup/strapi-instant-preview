import { Compile, type Validator as Compiled, type XSchema } from "typebox/schema";

import {
  annotate,
  type CmsOperation,
  type ValidationIssue,
  type Validator,
  validatorKey,
} from "./client.js";
import { $defs } from "./generated/schemas.js";

/** `/data/0/id` to `["data", 0, "id"]`. */
function pathOf(pointer: string): PropertyKey[] {
  return pointer
    .split("/")
    .slice(1)
    .map((part) => part.replaceAll("~1", "/").replaceAll("~0", "~"))
    .map((part) => (/^\d+$/u.test(part) ? Number(part) : part));
}

/**
 * The component schemas, and the same with no relation counts allowed.
 * Every relation refers to `StrapiCount` by name, so replacing it with
 * `false` (matches nothing) rejects a count wherever one could appear.
 */
// oxlint-disable-next-line typescript/no-unsafe-type-assertion
const definitions = $defs as Record<string, XSchema>;
const populatedDefinitions: Record<string, XSchema> = {
  ...definitions,
  StrapiCount: false,
};

/**
 * Give an operation the contract's JSON Schemas for its 2xx bodies, keyed by
 * status. Returns a copy: the operation itself stays unchecked.
 *
 * Each schema is compiled with TypeBox on first use, then reused. TypeBox
 * compiles to JavaScript where the environment allows it, and interprets
 * the schema where it does not (such as under a strict CSP).
 */
export const withSchemas = <Op extends CmsOperation>(
  operation: Op,
  schemas: Readonly<Record<number, object>>,
): Op => {
  const compiled = new Map<string, Compiled>();
  const validate: Validator = (status, data, populated) => {
    const schema = schemas[status];
    if (schema === undefined) return undefined;
    const key = `${status}:${populated}`;
    let validator = compiled.get(key);
    if (validator === undefined) {
      validator = Compile(
        populated ? populatedDefinitions : definitions,
        // oxlint-disable-next-line typescript/no-unsafe-type-assertion
        schema as XSchema,
      );
      compiled.set(key, validator);
    }
    if (validator.Check(data)) return { success: true, data };
    const [, errors] = validator.Errors(data);
    const issues: ValidationIssue[] = errors.map((error) => ({
      code: error.keyword,
      message: error.message,
      path: pathOf(error.instancePath),
    }));
    const message = errors
      .map((error) => `${error.instancePath || "/"} ${error.message}`)
      .join("; ");
    return { success: false, error: { message, issues } };
  };
  return annotate(operation, { [validatorKey]: validate });
};
