{
  "name": "@ryangreenup/strapi-typed-openapi-spec",
  "version": "1.0.0",
  "private": false,
  "description": "Generate OpenAPI Spec and API client for Strapi REST API",
  "keywords": [],
  "homepage": "https://github.com/RyanGreenup/strapi-instant-preview/tree/main/packages/autosave-draft#readme",
  "bugs": {
    "url": "https://github.com/RyanGreenup/strapi-instant-preview/issues"
  },
  "license": "GPL-3.0-only",
  "author": "Ryan Greenup <exogenesis@protonmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyanGreenup/strapi-instant-preview.git",
    "directory": "packages/autosave-draft"
  },
  "bin": {
    "openapi-contract": "./dist/server/src/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/server/src/library.d.ts",
      "default": "./dist/server/src/library.js"
    },
    "./cli": {
      "types": "./dist/server/src/cli/command.d.ts",
      "default": "./dist/server/src/cli/command.js"
    },
    "./tooling": {
      "types": "./dist/server/src/tooling/index.d.ts",
      "default": "./dist/server/src/tooling/index.js"
    },
    "./package.json": "./package.json",
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "default": "./dist/server/src/index.js"
    },
    "./testing": {
      "types": "./dist/server/src/testing/index.d.ts",
      "default": "./dist/server/src/testing/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsgo --skipLibCheck --noEmit",
    "lint": "oxlint -c oxlint.config.mts --type-aware --type-check . && oxfmt -c node_modules/@ryangreenup/oxlint-config/oxfmt.json --check .",
    "format": "oxfmt -c node_modules/@ryangreenup/oxlint-config/oxfmt.json --write .",
    "fix": "oxlint -c oxlint.config.mts --fix --fix-suggestions --type-aware --type-check .",
    "test": "vitest run tests/unit && node --test --test-concurrency=1 tests/api.test.cjs tests/query.test.cjs tests/spec.test.cjs",
    "test:fuzz": "node --test --test-concurrency=1 tests/fuzz.test.cjs"
  },
  "dependencies": {
    "@types/supertest": "catalog:",
    "acorn": "catalog:",
    "acorn-walk": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "citty": "catalog:",
    "json-logic-js": "catalog:",
    "orval": "catalog:",
    "path-to-regexp": "catalog:",
    "supertest": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@ryangreenup/oxlint-config": "workspace:*",
    "@ryangreenup/typescript-config": "workspace:*",
    "@strapi/strapi": "catalog:",
    "@types/json-logic-js": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "fast-check": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "qs": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.63.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22"
  },
  "strapi": {
    "kind": "plugin",
    "name": "openapi-contract",
    "displayName": "OpenAPI Typed Spec Generator",
    "description": "Generate OpenAPI Spec for Strapi REST API"
  }
}
