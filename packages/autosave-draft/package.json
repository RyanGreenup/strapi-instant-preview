{
  "name": "@ryangreenup/strapi-draft-autosave",
  "version": "1.0.1",
  "description": "Autosave Strapi drafts with a per-tab revert snapshot",
  "keywords": [],
  "homepage": "https://github.com/RyanGreenup/strapi-instant-preview/tree/main/packages/autosave-draft#readme",
  "bugs": {
    "url": "https://github.com/RyanGreenup/strapi-instant-preview/issues"
  },
  "license": "MIT",
  "author": "Ryan Greenup <ryanxgreenup@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyanGreenup/strapi-instant-preview.git",
    "directory": "packages/autosave-draft"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsgo --skipLibCheck --noEmit",
    "lint": "oxlint --type-aware --type-check . && oxfmt -c node_modules/@ryangreenup/oxlint-config/oxfmt.json --check .",
    "format": "oxfmt -c node_modules/@ryangreenup/oxlint-config/oxfmt.json --write .",
    "fix": "oxlint --fix --fix-suggestions --type-aware --type-check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {},
  "devDependencies": {
    "@ryangreenup/oxlint-config": "workspace:*",
    "@ryangreenup/typescript-config": "workspace:*",
    "@strapi/content-manager": "catalog:",
    "@strapi/design-system": "catalog:",
    "@strapi/strapi": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-intl": "catalog:",
    "styled-components": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@strapi/content-manager": "^5.62.0",
    "@strapi/design-system": "^2.3.1",
    "@strapi/strapi": "^5.62.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "styled-components": "^6.6.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "draft-autosave",
    "displayName": "Draft Autosave",
    "description": "Autosave drafts with a per-tab revert snapshot"
  }
}
