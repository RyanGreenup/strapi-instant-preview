{
  "name": "@rs/strapi-draft-autosave",
  "version": "0.0.1",
  "description": "Instantly preview a draft in a split by autosaving",
  "keywords": [],
  "license": "MIT",
  "author": "Ryan Greenup <ryanxgreenup@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsgo --skipLibCheck --noEmit",
    "lint": "oxlint --type-aware --type-check . && oxfmt -c node_modules/@rs/oxlint-config/oxfmt.json --check .",
    "format": "oxfmt -c node_modules/@rs/oxlint-config/oxfmt.json --write .",
    "fix": "oxlint --fix --fix-suggestions --type-aware --type-check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {},
  "devDependencies": {
    "@rs/oxlint-config": "workspace:*",
    "@rs/typescript-config": "workspace:*",
    "@strapi/design-system": "catalog:",
    "@strapi/icons": "catalog:",
    "@strapi/strapi": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-intl": "catalog:",
    "react-router-dom": "catalog:",
    "styled-components": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.3.1",
    "@strapi/icons": "^2.3.1",
    "@strapi/strapi": "^5.62.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.6.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "instant-preview",
    "displayName": "Instant Preview",
    "description": "Instantly preview a draft in a split by autosaving"
  }
}
