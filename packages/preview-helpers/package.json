{
  "name": "@rs/strapi-preview-helpers",
  "version": "0.0.1",
  "description": "Signed preview links and the preview-page iframe bridge for Strapi's native preview",
  "keywords": [],
  "license": "MIT",
  "author": "Ryan Greenup <ryanxgreenup@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "typesVersions": {
    "*": {
      "client": [
        "./dist/client/index.d.ts"
      ],
      "server": [
        "./dist/server/index.d.ts"
      ]
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./server": {
      "types": "./dist/server/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "source": "./client/src/index.ts",
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsgo --skipLibCheck --noEmit",
    "lint": "oxlint --type-aware --type-check . && oxfmt -c node_modules/@rs/oxlint-config/oxfmt.json --check .",
    "format": "oxfmt -c node_modules/@rs/oxlint-config/oxfmt.json --write .",
    "fix": "oxlint --fix --fix-suggestions --type-aware --type-check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@rs/oxlint-config": "workspace:*",
    "@rs/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
