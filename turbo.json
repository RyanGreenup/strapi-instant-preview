{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["transit", "^build"]
    },
    "format": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["transit", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.gitignore"]
    },
    "fix": {
      "dependsOn": ["^build", "^fix"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^transit", "^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^transit", "^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"]
    },
    "release": {
      "cache": false
    },
    "prepublishOnly": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
