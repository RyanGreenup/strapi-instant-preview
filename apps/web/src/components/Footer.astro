---
import type { Footer, SocialLink } from '@ryangreenup/contract';
import SocialLinks from './SocialLinks.astro';

interface Props {
	footer: Footer | null;
	siteName: string;
	socialLinks: SocialLink[];
}

const { footer, siteName, socialLinks } = Astro.props;
const year = new Date().getFullYear();
---

<footer>
	&copy; {year} {footer?.copyrightOwner ?? siteName}. {footer?.rightsNotice}
	<SocialLinks links={socialLinks} />
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	footer :global(.social-links) {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}
	footer :global(.social-links a) {
		text-decoration: none;
		color: rgb(var(--gray));
	}
	footer :global(.social-links a:hover) {
		color: rgb(var(--gray-dark));
	}
</style>
