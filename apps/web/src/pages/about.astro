---
import Blocks from '../components/Blocks.astro';
import BlogPost from '../layouts/BlogPost.astro';
import { getAbout } from '../lib/cms';

const about = await getAbout();
if (!about) {
	return new Response('Not found', { status: 404 });
}
---

<BlogPost
	title={about.hero?.title ?? about.title}
	description={about.hero?.description}
	image={about.hero?.image ?? null}
	publicationDate={about.hero?.publicationDate ?? null}
	updatedDate={about.hero?.updatedDate ?? null}
	seo={about.seo}
>
	<Blocks blocks={about.blocks} />
</BlogPost>
