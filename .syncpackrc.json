{
  "$schema": "https://unpkg.com/syncpack@15.3.3/dist/schema.json",
  "versionGroups": [
    {
      "label": "Use workspace links for internal dependencies.",
      "dependencies": ["@rs/**", "@moworks/**"],
      "dependencyTypes": ["!local"],
      "pinVersion": "workspace:*"
    },
    {
      "label": "Keep consumer peer ranges independent of build-time pins.",
      "dependencyTypes": ["peer"],
      "preferVersion": "highestSemver"
    },
    {
      "label": "Compiler API tools require TypeScript 6; plugin builds use TypeScript 7.",
      "packages": ["@rs/strapi-plugins", "@rs/oxlint-config"],
      "dependencies": ["typescript"],
      "dependencyTypes": ["dev"],
      "pinVersion": "catalog:typescript-api"
    },
    {
      "label": "Declare external versions in the workspace catalog.",
      "dependencyTypes": ["prod", "dev"],
      "policy": "catalog",
      "severity": {
        "NotUsingCatalog": "fix",
        "MissingFromCatalog": "fix"
      }
    }
  ]
}
